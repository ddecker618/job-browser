{
  "name": "job-browser",
  "version": "1.0.13",
  "description": "Local job discovery, deduplication, and application tracking",
  "main": "dist/src/desktop/main.js",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true,
    "esbuild": true,
    "sharp": true,
    "playwright": true
  },
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "tsx src/server/index.ts",
    "start": "node dist/src/server/index.js",
    "preview": "vite preview",
    "icon:build": "tsx scripts/generate-icon.ts",
    "desktop:dev": "npm run icon:build && tsc && electron .",
    "desktop:build": "npm run icon:build && npm run build",
    "desktop:start": "npm run desktop:build && electron . --built",
    "desktop:unpacked": "npm run desktop:build && tsx scripts/package-desktop.ts --dir",
    "desktop:package": "npm run desktop:build && tsx scripts/package-desktop.ts --nsis",
    "desktop:smoke": "npm run desktop:build && tsx scripts/desktop-smoke.ts",
    "desktop:smoke:packaged": "tsx scripts/desktop-smoke.ts --packaged",
    "desktop:smoke:installed": "tsx scripts/desktop-smoke.ts --installed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:seed": "tsx src/db/cli/seed.ts",
    "db:setup": "tsx src/db/cli/setup.ts",
    "discover": "tsx src/discovery/cli.ts",
    "discover:test": "tsx src/discovery/cli.ts --fixture",
    "analyze": "tsx src/intelligence/cli.ts",
    "analyze:test": "tsx src/intelligence/cli.ts --fixture",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "better-sqlite3": "12.11.1",
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fast-xml-parser": "^5.10.1",
    "mammoth": "1.11.0",
    "multer": "^2.2.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.57.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router": "^8.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "3.7.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@<1.1.17": "1.1.17",
    "brace-expansion@>=2.0.0 <2.1.3": "2.1.3"
  }
}
