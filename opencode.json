{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "Remove-Item *": "allow",
      "rmdir *": "deny",
      "del *": "deny",
      "format *": "deny"
    }
  }
}
